  "coverage": {
   "label": "Interest coverage",
   "family": "leverage and coverage",
   "formula": "operating margin / (operating margin - pre-tax margin)",
   "direction": -1,
   "shock": "recompute"
  },
  "implied_rate": {
   "label": "Implied interest rate",
   "family": "leverage and coverage",
   "formula": "(operating margin - pre-tax margin) x asset turnover / debt ratio",
   "direction": 1,
   "shock": "hold"
  },
  "ocf_liab": {
   "label": "Operating cash flow / liabilities",
   "family": "leverage and coverage",
   "formula": "OCF/sales x asset turnover / debt ratio",
   "direction": -1,
   "shock": "hold"
  },
  "fcf_liab": {
   "label": "Free cash flow / liabilities",
   "family": "leverage and coverage",
   "formula": "FCF/OCF x OCF/sales x asset turnover / debt ratio",
   "direction": -1,
   "shock": "hold"
  },
  "lt_liab_ta": {
   "label": "Long-term liabilities / assets",
   "family": "leverage and coverage",
   "formula": "debt ratio - current liabilities / assets (from ROCE)",
   "direction": 1,
   "shock": "hold"
  },
  "equity_liab": {
   "label": "Equity / liabilities",
   "family": "leverage and coverage",
   "formula": "(1 - debt ratio) / debt ratio",
   "direction": -1,
   "shock": "recompute"
  },
  "ebit_ta": {
   "label": "Operating profit / assets",
   "family": "profitability",
   "formula": "operating margin x asset turnover",
   "direction": -1,
   "shock": "recompute"
  },
  "accruals": {
   "label": "Accruals / assets",
   "family": "earnings quality",
   "formula": "(net margin - OCF/sales) x asset turnover",
   "direction": 0,
   "shock": "hold"
  },
  "cash_conversion": {
   "label": "Cash conversion",
   "family": "earnings quality",
   "formula": "OCF/sales / operating margin",
   "direction": 0,
   "shock": "hold"
  },
  "opex_burden": {
   "label": "Overheads / revenue",
   "family": "profitability",
   "formula": "gross margin - operating margin",
   "direction": 0,
   "shock": "hold"
  },
  "wc_ta": {
   "label": "Working capital / assets",
   "family": "liquidity",
   "formula": "(current ratio - 1) x current liabilities / assets",
   "direction": 0,
   "shock": "hold"
  },
  "cash_runway_days": {
   "label": "Cash runway (days)",
   "family": "liquidity",
   "formula": "cash ratio x current liabilities / assets / asset turnover / (1 - operating margin) x 365",
   "direction": -1,
   "shock": "hold"
  },
  "dpo_days": {
   "label": "Days payables outstanding",
   "family": "liquidity",
   "formula": "365 x (1 - gross margin) / payables turnover",
   "direction": 0,
   "shock": "hold"
  },
  "capex_rev": {
   "label": "Capex / revenue",
   "family": "investment",
   "formula": "(1 - FCF/OCF) x OCF/sales",
   "direction": 0,
   "shock": "hold"
  },
  "ppe_ta": {
   "label": "Fixed assets / assets",
   "family": "investment",
   "formula": "asset turnover / fixed asset turnover",
   "direction": 0,
   "shock": "hold"
  },
  "intangible_other_ta": {
   "label": "Intangible and other assets / assets",
   "family": "investment",
   "formula": "1 - current assets / assets - fixed assets / assets",
   "direction": 0,
   "shock": "hold"
  },
